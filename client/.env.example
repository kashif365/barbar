# Public values only — never put secrets or database credentials here.

# API base path. Leave as /api when the host proxies/rewrites /api to the backend (recommended),
# or set the full backend URL, e.g. https://your-api.onrender.com/api
VITE_API_BASE_URL=/api

# Socket.IO server origin. Leave empty in development (Vite proxies it).
# In production set the backend origin, e.g. https://your-api.onrender.com
VITE_SOCKET_URL=

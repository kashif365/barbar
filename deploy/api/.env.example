# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/shehraz-barber

# Comma-separated list of exact frontend origins allowed by CORS and the origin guard
CLIENT_ORIGIN=http://localhost:5173

# Long random strings (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
TRACKING_SECRET=replace-with-a-different-long-random-string-32-chars

# Cookie SameSite: "lax" when frontend and API share a site (recommended: proxy /api through the frontend host),
# "none" when they are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax

SALON_TIMEZONE=Asia/Karachi

# Only used by `npm run seed` to create the first owner. Remove after seeding.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Only used by `npm run seed:dev` (refused in production)
DEV_SEED_PASSWORD=
